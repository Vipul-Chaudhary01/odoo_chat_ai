<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mattermost_ai_user_mapping_list" model="ir.ui.view">
        <field name="name">mattermost.ai.user.mapping.list</field>
        <field name="model">mattermost.ai.user.mapping</field>
        <field name="arch" type="xml">
            <list>
                <field name="mattermost_user_id"/>
                <field name="mattermost_username"/>
                <field name="odoo_user_id"/>
                <field name="allowed_execute"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_mattermost_ai_user_mapping_form" model="ir.ui.view">
        <field name="name">mattermost.ai.user.mapping.form</field>
        <field name="model">mattermost.ai.user.mapping</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="mattermost_user_id" placeholder="e.g. 8da8sqt1tpfm8p3k8s7z9w4c1r"/>
                        <field name="mattermost_username" placeholder="vipul_chaudhary"/>
                        <field name="odoo_user_id"/>
                        <field name="allowed_execute"/>
                        <field name="active"/>
                    </group>
                    <group string="How to get Mattermost User ID">
                        <div class="text-muted">
                            In Mattermost: click your avatar → Profile → copy User ID
                            (or from Integrations slash-command logs / API).
                            Use the ID, not the @username.
                            Username field is only for display.
                        </div>
                    </group>
                    <group>
                        <field name="notes" placeholder="Optional notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mattermost_ai_user_mapping" model="ir.actions.act_window">
        <field name="name">User Mappings</field>
        <field name="res_model">mattermost.ai.user.mapping</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
