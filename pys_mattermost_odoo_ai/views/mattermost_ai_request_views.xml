<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mattermost_ai_request_list" model="ir.ui.view">
        <field name="name">mattermost.ai.request.list</field>
        <field name="model">mattermost.ai.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="state"/>
                <field name="mattermost_username"/>
                <field name="odoo_user_id"/>
                <field name="summary"/>
                <field name="operation_type"/>
                <field name="target_model"/>
                <field name="target_record_id"/>
                <field name="create_date"/>
                <field name="executed_at"/>
            </list>
        </field>
    </record>

    <record id="view_mattermost_ai_request_form" model="ir.ui.view">
        <field name="name">mattermost.ai.request.form</field>
        <field name="model">mattermost.ai.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="proposed,executing,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="mattermost_user_id" readonly="1"/>
                            <field name="mattermost_username" readonly="1"/>
                            <field name="odoo_user_id" readonly="1"/>
                            <field name="channel_id" readonly="1"/>
                            <field name="team_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="operation_type" readonly="1"/>
                            <field name="tool_name" readonly="1"/>
                            <field name="target_model" readonly="1"/>
                            <field name="target_record_id" readonly="1"/>
                            <field name="requires_confirmation" readonly="1"/>
                            <field name="expires_at" readonly="1"/>
                            <field name="confirmed_at" readonly="1"/>
                            <field name="executed_at" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Prompt">
                            <field name="prompt" readonly="1"/>
                            <field name="user_message" readonly="1"/>
                        </page>
                        <page string="Proposal">
                            <field name="ai_proposal_text" readonly="1"/>
                            <field name="proposal_json" readonly="1"/>
                            <field name="tool_arguments" readonly="1"/>
                        </page>
                        <page string="Result">
                            <field name="result_text" readonly="1"/>
                            <field name="result_json" readonly="1"/>
                            <field name="error_message" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mattermost_ai_requests" model="ir.actions.act_window">
        <field name="name">AI Requests</field>
        <field name="res_model">mattermost.ai.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
