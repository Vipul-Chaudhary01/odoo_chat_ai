<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_pys_mattermost_ai" model="ir.module.category">
        <field name="name">Mattermost AI</field>
        <field name="sequence">60</field>
    </record>

    <record id="res_groups_privilege_mattermost_ai" model="res.groups.privilege">
        <field name="name">Mattermost AI</field>
        <field name="sequence">60</field>
        <field name="category_id" ref="module_category_pys_mattermost_ai"/>
    </record>

    <record id="group_pys_mattermost_odoo_ai_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_mattermost_ai"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can view Mattermost AI requests.</field>
    </record>

    <record id="group_pys_mattermost_odoo_ai_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_mattermost_ai"/>
        <field name="implied_ids" eval="[(4, ref('group_pys_mattermost_odoo_ai_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Can configure Mattermost AI, mappings, and secrets.</field>
    </record>
</odoo>
